<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup / transfer rules (Android 12+).
   Cloud backup skips generated PDFs and the file index; device-to-device transfer keeps everything.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
</data-extraction-rules>
