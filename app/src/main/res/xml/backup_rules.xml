<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules (Android 11 and lower).
   Generated PDFs live in the external files dir and can be large, so they are not backed up;
   the file index (database) would point to missing files after a restore, so it is skipped too.
   Settings (shared preferences) are still backed up.
-->
<full-backup-content>
    <exclude domain="external" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
